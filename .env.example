PORT=2009
LOG_LEVEL=INFO
AGENT_NAME="LiftLine Dispatch Advisor"
AGENT_DESCRIPTION="Evaluate fictional LiftLine delivery from Zava Regional depot to Riverside: loaded capacity, site forklift requirements, arrival slots, and EUR quotes. Uses a bundled dispatch Skill with synthetic data. Use after Zava identifies an eligible origin. Does not own Zava stock or approval rules and cannot book."
# Public https base URL advertised in the agent card. Leave empty locally and on Azure Container Apps (auto-detected).
PUBLIC_BASE_URL=
AZURE_AI_ENDPOINT="https://cape-workshop-fy27-a2a--resource.services.ai.azure.com/openai/v1"
AZURE_AI_MODEL="gpt-chat-latest"
# Set a rotated key here locally; never commit .env or log this value. Configure Azure via a Container App secret reference.
AZURE_AI_API_KEY=

# deploy.sh only
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-a2a-server-bootcamp
AZURE_LOCATION=westeurope
AZURE_CONTAINER_APP=a2a-server-bootcamp
